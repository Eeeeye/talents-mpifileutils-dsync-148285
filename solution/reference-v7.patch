diff --git a/src/common/mfu_flist_copy.c b/src/common/mfu_flist_copy.c
index 0775116..578a504 100644
--- a/src/common/mfu_flist_copy.c
+++ b/src/common/mfu_flist_copy.c
@@ -2054,6 +2054,168 @@ fail_normal_copy:
     return -1;
 }

+/* Copy only data extents reported by SEEK_DATA / SEEK_HOLE.  Some Lustre PFL
+ * layouts and tmpfs support these operations while rejecting FIEMAP.  The
+ * normal_copy_required flag distinguishes an unsupported query (safe to fall
+ * back) from a failure after extent copying has started. */
+static int mfu_copy_file_lseek(
+    const char* src,
+    const char* dest,
+    uint64_t offset,
+    uint64_t length,
+    uint64_t file_size,
+    bool* normal_copy_required,
+    mfu_copy_opts_t* copy_opts,
+    mfu_file_t* mfu_src_file,
+    mfu_file_t* mfu_dst_file)
+{
+    *normal_copy_required = true;
+
+    if (copy_opts->direct) {
+        return -1;
+    }
+
+#ifdef DAOS_SUPPORT
+    if (mfu_src_file->type == DFS) {
+        return -1;
+    }
+#endif
+
+    off_t file_end = (off_t) file_size;
+    off_t chunk_start = (off_t) offset;
+    off_t chunk_end = (off_t) (offset + length);
+    if (chunk_end > file_end) {
+        chunk_end = file_end;
+    }
+
+    /* Empty files and empty chunks need only their logical size finalized. */
+    if (chunk_start >= chunk_end) {
+        *normal_copy_required = false;
+        goto complete;
+    }
+
+    errno = 0;
+    off_t data = mfu_file_lseek(src, mfu_src_file, chunk_start, SEEK_DATA);
+    if (data < 0) {
+        if (errno == ENXIO) {
+            /* SEEK_DATA is supported, but this chunk has no more data. */
+            *normal_copy_required = false;
+            goto complete;
+        }
+        return -1;
+    }
+
+    if (data >= chunk_end) {
+        *normal_copy_required = false;
+        goto complete;
+    }
+
+    errno = 0;
+    off_t hole = mfu_file_lseek(src, mfu_src_file, data, SEEK_HOLE);
+    if (hole < 0) {
+        if (errno == ENXIO) {
+            hole = file_end;
+        } else {
+            return -1;
+        }
+    }
+
+    /* Both extent operations are available, so a later error must not fall
+     * back to a normal copy after partially writing the destination. */
+    *normal_copy_required = false;
+
+    size_t buf_size = copy_opts->buf_size;
+    void* buf = copy_opts->block_buf1;
+
+    while (data < chunk_end) {
+        if (hole > chunk_end) {
+            hole = chunk_end;
+        }
+        if (hole < data) {
+            MFU_LOG(MFU_LOG_ERR,
+                "Invalid sparse extent for `%s': data=%lld hole=%lld",
+                src, (long long) data, (long long) hole);
+            return -1;
+        }
+
+        off_t pos = data;
+        while (pos < hole) {
+            size_t bytes = (size_t) MIN((uint64_t) (hole - pos),
+                                        (uint64_t) buf_size);
+            ssize_t num_read = mfu_file_pread(src, buf, bytes, pos, mfu_src_file);
+            if (num_read <= 0) {
+                MFU_LOG(MFU_LOG_ERR,
+                    "Read error in sparse extent `%s' (errno=%d %s)",
+                    src, errno, strerror(errno));
+                return -1;
+            }
+
+            ssize_t written = 0;
+            while (written < num_read) {
+                ssize_t num_written = mfu_file_pwrite(
+                    dest, ((char*) buf) + written,
+                    (size_t) (num_read - written), pos + written,
+                    mfu_dst_file);
+                if (num_written <= 0) {
+                    MFU_LOG(MFU_LOG_ERR,
+                        "Write error in sparse extent `%s' to `%s' (errno=%d %s)",
+                        src, dest, errno, strerror(errno));
+                    return -1;
+                }
+                written += num_written;
+            }
+
+            pos += num_read;
+            mfu_copy_stats.total_bytes_copied += (int64_t) num_read;
+        }
+
+        if (hole >= chunk_end) {
+            break;
+        }
+
+        errno = 0;
+        data = mfu_file_lseek(src, mfu_src_file, hole, SEEK_DATA);
+        if (data < 0) {
+            if (errno == ENXIO) {
+                break;
+            }
+            MFU_LOG(MFU_LOG_ERR,
+                "Failed to find next data extent in `%s' (errno=%d %s)",
+                src, errno, strerror(errno));
+            return -1;
+        }
+        if (data >= chunk_end) {
+            break;
+        }
+
+        errno = 0;
+        hole = mfu_file_lseek(src, mfu_src_file, data, SEEK_HOLE);
+        if (hole < 0) {
+            if (errno == ENXIO) {
+                hole = file_end;
+            } else {
+                MFU_LOG(MFU_LOG_ERR,
+                    "Failed to find next hole in `%s' (errno=%d %s)",
+                    src, errno, strerror(errno));
+                return -1;
+            }
+        }
+    }
+
+complete:
+    if (chunk_end >= file_end || file_size == 0) {
+        if (mfu_file_ftruncate(mfu_dst_file, file_end) < 0) {
+            MFU_LOG(MFU_LOG_ERR,
+                "Failed to truncate destination file: %s (errno=%d %s)",
+                dest, errno, strerror(errno));
+            return -1;
+        }
+    }
+
+    mfu_copy_stats.total_size += (int64_t) (chunk_end - chunk_start);
+    return 0;
+}
+
 static int mfu_copy_file(
     const char* src,
     const char* dest,
@@ -2086,9 +2248,16 @@ static int mfu_copy_file(

     if (copy_opts->sparse) {
         bool normal_copy_required;
+        ret = mfu_copy_file_lseek(src, dest, offset, length, file_size,
+                                  &normal_copy_required, copy_opts,
+                                  mfu_src_file, mfu_dst_file);
+        if (!ret || !normal_copy_required) {
+            return ret;
+        }
+
         ret = mfu_copy_file_fiemap(src, dest, offset, length, file_size,
-                               &normal_copy_required, copy_opts,
-                               mfu_src_file, mfu_dst_file);
+                                   &normal_copy_required, copy_opts,
+                                   mfu_src_file, mfu_dst_file);
         if (!ret || !normal_copy_required) {
             return ret;
         }
