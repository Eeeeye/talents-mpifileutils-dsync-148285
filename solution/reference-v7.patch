+    mfu_path_delete(&dest_parent);
+
+    int dest_parent_valid = 1;
+    if (rank == 0) {
+        struct stat dest_parent_stat;
+        if (mfu_file_stat(dest_parent_str, &dest_parent_stat, mfu_dst_file) < 0) {
+            MFU_LOG(MFU_LOG_ERR,
+                "Destination parent directory is not accessible `%s' (errno=%d %s)",
+                dest_parent_str, errno, strerror(errno));
+            dest_parent_valid = 0;
+        } else if (!S_ISDIR(dest_parent_stat.st_mode)) {
+            MFU_LOG(MFU_LOG_ERR,
+                "Destination parent path is not a directory `%s'",
