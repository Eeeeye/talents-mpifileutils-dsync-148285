+    mfu_param_path dest_compare_storage;
+    mfu_param_path* dest_compare_path = destpath;
+    int dest_compare_allocated = 0;
+    if (copy_into_dir && srcpath->path_stat_valid &&
+        !S_ISDIR(srcpath->path_stat.st_mode))
+    {
+        mfu_path* dest_item = mfu_path_from_str(destpath->path);
+        mfu_path* src_base = mfu_path_from_str(srcpath->path);
+        mfu_path_basename(src_base);
+        mfu_path_append(dest_item, src_base);
+        char* dest_item_str = mfu_path_strdup(dest_item);
+        mfu_path_delete(&src_base);
+        mfu_path_delete(&dest_item);
+
+        mfu_param_path_set(dest_item_str, &dest_compare_storage,
+                           mfu_dst_file, false);
+        mfu_free(&dest_item_str);
+        dest_compare_path = &dest_compare_storage;
+        dest_compare_allocated = 1;
+    }
