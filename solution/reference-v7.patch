+
+    /* Determine copy topology before building comparison lists.  When a
+     * non-directory source is synchronized into an existing directory, the
+     * object to compare is DEST/basename rather than DEST itself. */
+    int copy_into_dir = 0;
+    if (destpath->path_stat_valid) {
+        if (S_ISDIR(destpath->path_stat.st_mode)) {
+            copy_into_dir = 1;
+        } else if (S_ISLNK(destpath->path_stat.st_mode) &&
+                   destpath->target_stat_valid &&
+                   S_ISDIR(destpath->target_stat.st_mode)) {
+            copy_into_dir = 1;
+        }
+    }
+    copy_opts->copy_into_dir = copy_into_dir;
