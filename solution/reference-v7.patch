+            dest_parent_valid = 0;
+        } else if (mfu_file_access(dest_parent_str, W_OK, mfu_dst_file) < 0) {
+            MFU_LOG(MFU_LOG_ERR,
+                "Destination parent directory is not writable `%s' (errno=%d %s)",
+                dest_parent_str, errno, strerror(errno));
+            dest_parent_valid = 0;
+        }
+    }
+    MPI_Bcast(&dest_parent_valid, 1, MPI_INT, 0, MPI_COMM_WORLD);
+    mfu_free(&dest_parent_str);
